    <string name="sw_datenschutz_titel">Confidentialité</string>
    <string name="sw_datenschutz_kurz">Tout reste sur cet appareil.</string>
    <string name="sw_datenschutz_geraet_titel">Ce qui reste sur l\'appareil</string>
    <string name="sw_datenschutz_geraet_text">Enregistrement, reconnaissance, historique et blocs de texte restent uniquement sur ce téléphone. L\'audio est supprimé après la conversion, sauf si vous choisissez de le conserver.</string>
    <string name="sw_datenschutz_netz_titel">Ce que voit le réseau</string>
    <string name="sw_datenschutz_netz_text">Rien. Nibra ne demande aucun accès réseau, n\'a ni compte, ni paiement, ni traceurs.</string>
    <string name="sw_datenschutz_dienst_titel">À quoi sert le service d\'accessibilité</string>
    <string name="sw_datenschutz_dienst_text">Il insère le texte reconnu là où se trouve votre curseur. Il ne lit rien, n\'enregistre rien et laisse les champs de mot de passe intacts.</string>
    <string name="sw_datenschutz_loeschen_titel">Ce que vous pouvez supprimer</string>
    <string name="sw_datenschutz_loeschen_text">Vous supprimez chaque dictée dans l\'historique. En désinstallant l\'appli, toutes les données disparaissent avec elle.</string>

