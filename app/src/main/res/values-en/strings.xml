    <string name="sw_einrichtung_titel">Set up Loqui</string>
    <string name="sw_einrichtung_willkommen_titel">Speak. Loqui writes.</string>
    <string name="sw_einrichtung_willkommen_text">Two steps and you can dictate into any app — no account, no network, no traces.</string>
    <string name="sw_einrichtung_schritt_format">Step %1$d of %2$d</string>
    <string name="sw_einrichtung_mikrofon_titel">Allow the microphone</string>
    <string name="sw_einrichtung_mikrofon_text">Loqui records only while you start it. The recording is turned into text on the device and discarded afterwards.</string>
    <string name="sw_einrichtung_mikrofon_handlung">Allow microphone</string>
    <string name="sw_einrichtung_mikrofon_erteilt">Microphone is allowed</string>
    <string name="sw_einrichtung_dienst_titel">Allow inserting</string>
    <string name="sw_einrichtung_dienst_offenlegung">Loqui uses the Android accessibility service for one purpose only: to insert recognised text into the field where your cursor is. The service reads no content, sends nothing and skips password fields.</string>
    <string name="sw_einrichtung_dienst_handlung">Turn on service</string>
    <string name="sw_einrichtung_dienst_eingerichtet">Service is active</string>
    <string name="sw_einrichtung_dienst_systemhinweis">The system settings open. Pick Loqui there and switch the service on.</string>
    <string name="sw_einrichtung_spaeter">Later</string>
    <string name="sw_einrichtung_los">Let\'s go</string>

    <string name="sw_datenschutz_titel">Privacy</string>
    <string name="sw_datenschutz_kurz">Everything stays on this device.</string>
    <string name="sw_datenschutz_geraet_titel">What stays on the device</string>
    <string name="sw_datenschutz_geraet_text">Recording, recognition, history and text snippets live on this phone only. The audio is discarded after the conversion unless you explicitly keep it.</string>
    <string name="sw_datenschutz_netz_titel">What the network sees</string>
    <string name="sw_datenschutz_netz_text">Nothing. Loqui does not request network access, has no account, no payment and no trackers.</string>
    <string name="sw_datenschutz_dienst_titel">What the accessibility service is for</string>
    <string name="sw_datenschutz_dienst_text">It inserts the recognised text where your cursor is. It does not read along, records nothing and leaves password fields untouched.</string>
    <string name="sw_datenschutz_loeschen_titel">What you can delete</string>
    <string name="sw_datenschutz_loeschen_text">You delete each dictation individually in the history. Removing the app removes all data with it.</string>

    <string name="sw_fremdsoftware_titel">Third-party software</string>
    <string name="sw_fremdsoftware_hinweis">Loqui builds on this work. The full licence texts ship with the app.</string>
