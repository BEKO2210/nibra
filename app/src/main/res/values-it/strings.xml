    <string name="sw_datenschutz_titel">Privacy</string>
    <string name="sw_datenschutz_kurz">Tutto resta su questo dispositivo.</string>
    <string name="sw_datenschutz_geraet_titel">Che cosa resta sul dispositivo</string>
    <string name="sw_datenschutz_geraet_text">Registrazione, riconoscimento, cronologia e blocchi di testo restano solo su questo telefono. L\'audio viene scartato dopo la conversione, a meno che tu non scelga di conservarlo.</string>
    <string name="sw_datenschutz_netz_titel">Che cosa vede la rete</string>
    <string name="sw_datenschutz_netz_text">Nulla. Loqui non chiede accesso alla rete, non ha account, pagamenti o tracker.</string>
    <string name="sw_datenschutz_dienst_titel">A che cosa serve il servizio di accessibilità</string>
    <string name="sw_datenschutz_dienst_text">Inserisce il testo riconosciuto dove si trova il cursore. Non legge nulla, non registra nulla e lascia intatti i campi password.</string>
    <string name="sw_datenschutz_loeschen_titel">Che cosa puoi eliminare</string>
    <string name="sw_datenschutz_loeschen_text">Ogni dettatura si elimina singolarmente nella cronologia. Disinstallando l\'app spariscono tutti i dati.</string>

