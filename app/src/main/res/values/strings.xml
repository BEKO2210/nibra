    <!-- Datenschutz -->
    <string name="sw_datenschutz_titel">Datenschutz</string>
    <string name="sw_datenschutz_kurz">Alles bleibt auf diesem Gerät.</string>
    <string name="sw_datenschutz_geraet_titel">Was auf dem Gerät bleibt</string>
    <string name="sw_datenschutz_geraet_text">Aufnahme, Erkennung, Verlauf und Textbausteine liegen ausschließlich auf diesem Telefon. Die Tonaufnahme wird nach der Umwandlung verworfen, solange du sie nicht ausdrücklich behältst.</string>
    <string name="sw_datenschutz_netz_titel">Was das Netz sieht</string>
    <string name="sw_datenschutz_netz_text">Nichts. Loqui fordert kein Recht auf Netzzugang an, hat kein Konto, keine Bezahlung und keine Tracker.</string>
    <string name="sw_datenschutz_dienst_titel">Wozu der Bedienungshilfen-Dienst dient</string>
    <string name="sw_datenschutz_dienst_text">Er fügt den erkannten Text an der Stelle ein, an der dein Cursor steht. Er liest nicht mit, zeichnet nichts auf und lässt Passwortfelder unberührt.</string>
    <string name="sw_datenschutz_loeschen_titel">Was du löschen kannst</string>
    <string name="sw_datenschutz_loeschen_text">Jedes Diktat löschst du einzeln im Verlauf. Beim Entfernen der App verschwinden alle Daten mit ihr.</string>

