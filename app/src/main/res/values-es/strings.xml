    <string name="sw_datenschutz_titel">Privacidad</string>
    <string name="sw_datenschutz_kurz">Todo se queda en este dispositivo.</string>
    <string name="sw_datenschutz_geraet_titel">Qué se queda en el dispositivo</string>
    <string name="sw_datenschutz_geraet_text">Grabación, reconocimiento, historial y bloques de texto están solo en este teléfono. El audio se descarta tras la conversión, salvo que decidas conservarlo.</string>
    <string name="sw_datenschutz_netz_titel">Qué ve la red</string>
    <string name="sw_datenschutz_netz_text">Nada. Loqui no pide acceso a la red, no tiene cuenta, ni pagos, ni rastreadores.</string>
    <string name="sw_datenschutz_dienst_titel">Para qué sirve el servicio de accesibilidad</string>
    <string name="sw_datenschutz_dienst_text">Inserta el texto reconocido donde está tu cursor. No lee nada, no registra nada y no toca los campos de contraseña.</string>
    <string name="sw_datenschutz_loeschen_titel">Qué puedes borrar</string>
    <string name="sw_datenschutz_loeschen_text">Cada dictado se borra por separado en el historial. Al desinstalar la app desaparecen todos los datos con ella.</string>

