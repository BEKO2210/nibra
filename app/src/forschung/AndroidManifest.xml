<?xml version="1.0" encoding="utf-8"?>
<!--
    Nur fuer die Forschungsauspraegung.

    Sie darf ins Netz, weil sie Cloud-Erkenner messen soll. Sie ist
    ausdruecklich **kein** Auslieferungsstand: eigener Paketname, eigener
    Fassungszusatz, und sie gehoert nie in einen Laden.

    Die Auspraegung `offline` hat kein Gegenstueck zu dieser Datei. Sie kann
    diese Berechtigung nicht bekommen, auch nicht aus Versehen.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Nicht exportiert.

      Der Messplatz startet auf eine Absicht hin das Mikrofon, ohne dass
      jemand etwas antippt. Exportiert hiesse: jede mitinstallierte App kann
      das auslösen, also eine Aufnahme ohne eigenes Mikrofonrecht, deren
      Ergebnis anschliessend in der Ablage liegt.

      Gestartet wird über eine Instrumentierung (Messplatzstart), die im
      Prozess der App selbst läuft und deshalb nicht exportierte
      Aktivitäten starten darf. Die Zugangskontrolle trägt damit Android
      und nicht ein selbstgebauter Schlüssel.

      Nachgeprüft am Gerät: `am start` scheitert mit SecurityException,
      `am instrument` läuft.
    -->
    <application>
        <!--
            Der Messplatz. Nur in dieser Auspraegung vorhanden; die
            Auslieferungsfassung kennt ihn nicht.
        -->
        <activity
            android:name=".forschung.ForschungActivity"
            android:exported="false"
            android:label="Nibra Messplatz" />
        <activity
            android:name=".forschung.Blasenprobestand"
            android:exported="false"
            android:label="Blasen-Belastungsstand" />
        <activity
            android:name=".forschung.Feldprobe"
            android:exported="false"
            android:windowSoftInputMode="stateAlwaysVisible"
            android:label="Feldprobe" />
    </application>
</manifest>
