<?xml version="1.0" encoding="utf-8"?>
<!--
    Nur fuer die Forschungsauspraegung.

    Sie darf ins Netz, weil sie Cloud-Erkenner messen soll. Sie ist
    ausdruecklich **kein** Auslieferungsstand: eigener Paketname, eigener
    Fassungszusatz, und sie gehoert nie in einen Laden.

    Die Auspraegung `offline` hat kein Gegenstueck zu dieser Datei. Sie kann
    diese Berechtigung nicht bekommen, auch nicht aus Versehen.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Exportiert, aber verschlossen.

      Der Messplatz startet auf eine Absicht hin das Mikrofon, ohne dass
      jemand etwas antippt. Exportiert allein hiesse: jede mitinstallierte
      App kann das auslösen, also eine Aufnahme ohne eigenes Mikrofonrecht,
      deren Ergebnis anschliessend in der Ablage liegt.

      Nicht exportiert wäre die naheliegende Antwort, aber dann kann auch
      adb nichts mehr starten, und die ganze Messung ist von Hand zu
      bedienen. Nachgeprüft: die Shell darf keine nicht exportierte
      Aktivität starten, sie bekommt eine SecurityException.

      Stattdessen ein Schlüssel. Beim ersten Start legt der Messplatz eine
      Zufallszahl in seinem **privaten** Verzeichnis ab. Jede Messabsicht
      muss sie mitbringen. adb kommt über `run-as` an die Datei heran, eine
      fremde App nicht.
    -->
    <application>
        <!--
            Der Messplatz. Nur in dieser Auspraegung vorhanden; die
            Auslieferungsfassung kennt ihn nicht.
        -->
        <activity
            android:name=".forschung.ForschungActivity"
            android:exported="true"
            android:label="Nibra Messplatz" />
        <activity
            android:name=".forschung.Blasenprobestand"
            android:exported="true"
            android:label="Blasen-Belastungsstand" />
        <activity
            android:name=".forschung.Feldprobe"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysVisible"
            android:label="Feldprobe" />
    </application>
</manifest>
